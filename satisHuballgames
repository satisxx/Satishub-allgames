local function updatePreviewBones()
    if not (states.Skeleton or states.SkeletonRGB) then return end
    if not UIX.previewRig or not UIX.previewViewport.Visible then
        for i,segment in ipairs(UIX.previewBones) do
            local fallback=UIX.skeletonCoords[((i-1)%#UIX.skeletonCoords)+1]
            local a,b=fallback[1],fallback[2]
            local x=Vector2.new(a[1],a[2]);local y=Vector2.new(b[1],b[2])
            local d=y-x
            segment.Position=UDim2.fromOffset((x.X+y.X)/2,(x.Y+y.Y)/2)
            segment.Size=UDim2.fromOffset(d.Magnitude,2)
            segment.Rotation=math.deg(math.atan2(d.Y,d.X))
        end
        return
    end
    local rig=UIX.previewRig
    local chains
    if rig:FindFirstChild("UpperTorso") then
        chains={{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
            {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
            {"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},
            {"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
            {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
            {"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},
            {"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
    else
        chains={{"Head","Torso"},{"Torso","Torso"},{"Torso","Left Arm"},
            {"Left Arm","Left Arm"},{"Left Arm","Left Arm"},
            {"Torso","Right Arm"},{"Right Arm","Right Arm"},{"Right Arm","Right Arm"},
            {"Torso","Left Leg"},{"Left Leg","Left Leg"},{"Left Leg","Left Leg"},
            {"Torso","Right Leg"},{"Right Leg","Right Leg"},{"Right Leg","Right Leg"}}
    end
    for i,segment in ipairs(UIX.previewBones) do
        local pair=chains[i]
        local a=pair and rig:FindFirstChild(pair[1])
        local b=pair and rig:FindFirstChild(pair[2])
        local pa=a and projectPreview(a.Position)
        local pb=b and projectPreview(b.Position)
        -- R6 parts represent entire limbs: draw from their centre to the end.
        if a and b and a==b and a.Name~="Torso" then
            pb=projectPreview(a.CFrame:PointToWorldSpace(Vector3.new(0,-a.Size.Y*.48,0)))
        end
        if pa and pb and (pb-pa).Magnitude>2 then
            local d=pb-pa
            segment.Position=UDim2.fromOffset((pa.X+pb.X)/2,(pa.Y+pb.Y)/2)
            segment.Size=UDim2.fromOffset(d.Magnitude,2)
            segment.Rotation=math.deg(math.atan2(d.Y,d.X))

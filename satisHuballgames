-- RGB na própria personagem: personalização local, com restauração ao desligar.
local savedPartColors={}
local rainbowGlow=nil
local rainbowCharacter=nil
local rainbowLast=0
local function restoreRainbow()
    for part,original in pairs(savedPartColors) do
        if part and part.Parent then pcall(function()part.Color=original end) end
    end
    table.clear(savedPartColors)
    if rainbowGlow then rainbowGlow:Destroy();rainbowGlow=nil end
    rainbowCharacter=nil
end
con(RunService.Heartbeat:Connect(function()
    if not alive then return end
    if not states.Rainbow then
        if rainbowCharacter then restoreRainbow() end
        return
    end
    local char=player.Character
    if char~=rainbowCharacter then
        restoreRainbow()
        rainbowCharacter=char
        if char then
            rainbowGlow=el("Highlight",{Name="UB_RainbowLocal",Adornee=char,FillTransparency=.75,OutlineTransparency=.08,DepthMode=Enum.HighlightDepthMode.Occluded},char)
        end
    end
    if not char then return end
    if os.clock()-rainbowLast<.075 then return end
    rainbowLast=os.clock()
    local phase=(os.clock()*.2)%1
    local i=0
    for _,part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name~="HumanoidRootPart" and part.Transparency<.98 and not part:FindFirstAncestorOfClass("Tool") then
            if savedPartColors[part]==nil then savedPartColors[part]=part.Color end
            i+=1
            part.Color=Color3.fromHSV((phase+i*.055)%1,.9,1)
        end
    end
    if rainbowGlow then
        rainbowGlow.FillColor=Color3.fromHSV(phase,1,1)
        rainbowGlow.OutlineColor=Color3.fromHSV((phase+.25)%1,1,1)
    end
end))



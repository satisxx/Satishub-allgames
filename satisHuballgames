local function getTarget(cam,range)
    local center=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
    local best=range or 155
    local nearest=nil
    -- Prefer the character directly under the central camera ray.
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={player.Character}
    local hit=Workspace:Raycast(cam.CFrame.Position,cam.CFrame.LookVector*600,params)
    if hit then
        local ancestor=hit.Instance:FindFirstAncestorOfClass("Model")
        local onRay=ancestor and Players:GetPlayerFromCharacter(ancestor)
        if onRay and onRay~=player and living(onRay) then
            return onRay
        end
    end
    -- Fallback: the player closest to the centre of the camera.
    for p in pairs(visuals)do
        local _,root=living(p)
        if root then
            local sp,onScreen=cam:WorldToViewportPoint(root.Position)
            if onScreen and sp.Z>0 then
                local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
                if d<best then best=d;nearest=p end
            end
        end
    end
    return nearest
end
local function getAimTarget(cam)
    local vp=cam.ViewportSize
    local center=Vector2.new(vp.X/2,vp.Y/2)
    local nearestPart=nil
    local nearestDist=aimFOV
    local eligible=0
    for p in pairs(visuals) do
        local sameTeam=(player.Team~=nil and p.Team==player.Team)
        local c,root=living(p)
        if c and not sameTeam then
            local bone=(aimTargetPart=="Head") and c:FindFirstChild("Head")
                or (c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or root)
            if bone then
                local sp,inView=cam:WorldToViewportPoint(bone.Position)
                if inView and sp.Z>0 then
                    local dist=(Vector2.new(sp.X,sp.Y)-center).Magnitude
                    if dist<=aimFOV then
                        eligible+=1
                        if dist<nearestDist then
                            -- Line-of-sight test; ignore own character and the target character.
                            local params=RaycastParams.new()
                            params.FilterType=Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances={player.Character}
                            local ray=Workspace:Raycast(cam.CFrame.Position,bone.Position-cam.CFrame.Position,params)
                            if not ray or ray.Instance:IsDescendantOf(c) then
                                nearestPart=bone
                                nearestDist=dist
                            end
                        end
                    end
                end
            end
        end
    end
    return nearestPart,eligible
end

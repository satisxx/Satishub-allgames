local okPortrait, portraitError = pcall(function()
    local assetService = game:GetService("AssetService")
    local edit = assetService:CreateEditableImage({Size=Vector2.new(PORTRAIT_SIZE, PORTRAIT_SIZE)})
    assert(edit, "EditableImage indisponivel (memoria/permissoes)")
    local pixels = buffer.create(PORTRAIT_SIZE * PORTRAIT_SIZE * 4)
    for i = 0, PORTRAIT_SIZE*PORTRAIT_SIZE-1 do
        local n = tonumber(PORTRAIT_RGB565:sub(i*4+1, i*4+4), 16)
        local r = bit32.rshift(n,11)
        local g = bit32.band(bit32.rshift(n,5),63)
        local b = bit32.band(n,31)
        local p = i*4
        buffer.writeu8(pixels,p,math.floor(r*255/31+0.5))
        buffer.writeu8(pixels,p+1,math.floor(g*255/63+0.5))
        buffer.writeu8(pixels,p+2,math.floor(b*255/31+0.5))
        buffer.writeu8(pixels,p+3,255)
    end
    edit:WritePixelsBuffer(Vector2.zero,Vector2.new(PORTRAIT_SIZE,PORTRAIT_SIZE),pixels)
    UIX.avatar.ImageContent=Content.fromObject(edit)
    UIX.editablePortrait=edit
end)

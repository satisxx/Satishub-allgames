-- RAGE MODE para testes num jogo próprio: giro local, câmara em alvos próximos
-- e Tool:Activate() quando a ferramenta equipada suporta essa ação.
-- Não simula eventos privados nem contorna validações do servidor.
UIX.rageLastShot=0
UIX.rageTarget=function()
    local char=player.Character
    local myRoot=char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best=85
    local result=nil
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=player and not (player.Team and p.Team and player.Team==p.Team) then
            local enemy=p.Character
            local headPart=enemy and enemy:FindFirstChild("Head")
            local hum=enemy and enemy:FindFirstChildOfClass("Humanoid")
            if headPart and hum and hum.Health>0 then
                local distance=(headPart.Position-myRoot.Position).Magnitude
                if distance<best then best=distance;result=headPart end
            end
        end
    end
    return result
end
UIX.oldAutoRotate=nil
UIX.rageTick=function(dt)
    if not alive then return end
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if not states.Rage then
        if hum and UIX.oldAutoRotate~=nil then hum.AutoRotate=UIX.oldAutoRotate;UIX.oldAutoRotate=nil end
        return
    end
    if not root or not hum or hum.Health<=0 then return end
    if UIX.oldAutoRotate==nil then UIX.oldAutoRotate=hum.AutoRotate end
    hum.AutoRotate=false
    root.CFrame=root.CFrame*CFrame.Angles(0,math.rad(900)*math.min(dt,.1),0)
    local headPart=UIX.rageTarget()
    local camera=Workspace.CurrentCamera
    if headPart and camera and not (main.Visible and not minimized) then
        camera.CFrame=CFrame.lookAt(camera.CFrame.Position,headPart.Position)
        if os.clock()-UIX.rageLastShot>.26 then
            UIX.rageLastShot=os.clock()
            local tool=char:FindFirstChildOfClass("Tool")
            if tool and tool.Enabled then tool:Activate() end
        end
    end
end

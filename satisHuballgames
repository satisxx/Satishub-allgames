end)
con(UIS.InputBegan:Connect(function(input,processed)
    if input.UserInputType~=Enum.UserInputType.Keyboard or input.KeyCode==Enum.KeyCode.Unknown then return end
    -- Never activate keybinds while writing in chat or a TextBox.
    if UIS:GetFocusedTextBox() then return end
    if changing=="tp" then
        -- Avoid hotkeys that already control this menu or the camera.
        if input.KeyCode==Enum.KeyCode.F6 or input.KeyCode==Enum.KeyCode.F7 or input.KeyCode==UIX.menuKey then
            UIX.status.Text=(UIX.language=="pt-PT" and "Essa tecla já está reservada para o menu" or "That key is reserved for the menu")
            UIX.tpButton.Text=tpKey.Name
            changing=nil
            return
        end
        tpKey=input.KeyCode
        UIX.tpButton.Text=tpKey.Name
        changing=nil
        UIX.saveConfig()
        UIX.status.Text=(UIX.language=="pt-PT" and "Tecla de teleporte: " or "Teleport key: ")..tpKey.Name
        return
    elseif changing=="menu" then
        if input.KeyCode==tpKey then
            UIX.status.Text=(UIX.language=="pt-PT" and "Essa tecla já é usada pelo teleporte" or "That key is already used for teleport")
            UIX.shiftToggle.Text=UIX.menuKey.Name
            changing=nil
            return
        end
        UIX.menuKey=input.KeyCode
        UIX.shiftToggle.Text=UIX.menuKey.Name
        headerHint.Text="SATIS  /  GREY EDITION     •     F6 / "..UIX.menuKey.Name.." / BOTÃO"
        changing=nil
        UIX.saveConfig()
        return
    end
    if input.KeyCode==Enum.KeyCode.F7 then
        states.FirstPerson=false
        UIX.firstToggle.Text="OFF"
        UIX.firstToggle.BackgroundColor3=col.border
        updateCameraMode()
        if states.AutoSave then UIX.saveConfig() end
        return
    end
    -- Roblox may mark a game hotkey as 'processed'.
    -- Accept the configured teleport key anyway, provided no text field is focused.
    if input.KeyCode==tpKey then
        tryTeleport()
        return
    end
    -- Keep ordinary menu key handling limited to unprocessed input.
    if not processed and (input.KeyCode==Enum.KeyCode.F6 or input.KeyCode==UIX.menuKey) then
        setMinimized(not minimized)
    end
end))

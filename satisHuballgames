UIX.translate=function(message,locale)
    if type(message)~="string" or #message==0 then return message end
    local dictionary=(locale=="en") and UIX.enByPT or UIX.ptByEN
    if dictionary[message] then return dictionary[message] end
    -- Match the entire hint suffix, not TELEPORT inside TELEPORTAR.
    -- This prevents repeated additions of AR on every localisation pass.
    if locale=="en" then
        if message:match("%] TELEPORTAR$") then
            return (message:gsub("%] TELEPORTAR$", "] TELEPORT"))
        end
    else
        if message:match("%] TELEPORT$") then
            return (message:gsub("%] TELEPORT$", "] TELEPORTAR"))
        end
    end
    -- Dynamic text: key names, slider values and player names stay intact.
    local patterns={
        {"RAIO DO FOV  •  ","FOV RADIUS  •  "},
        {" / BOTÃO"," / BUTTON"},
        {"Transparencia do fundo  •  ","Background transparency  •  "},
        {"Auto Teleport ativo: ","Auto Teleport enabled: "},
        {" segundos"," seconds"},
        {" • PREVIEW"," • PREVIEW"},
        {"AUTO SAVE  •  GUARDADO LOCALMENTE","AUTO SAVE  •  SAVED LOCALLY"},
        {"AUTO SAVE  •  APENAS NESTA SESSÃO","AUTO SAVE  •  THIS SESSION ONLY"},
        {"AUTO SAVE  •  DESATIVADO","AUTO SAVE  •  DISABLED"},
    }
    local output=message
    for _,p in ipairs(patterns) do
        local old=(locale=="en") and p[1] or p[2]
        local new=(locale=="en") and p[2] or p[1]
        if old~=new then output=output:gsub(old:gsub("([%%%^%$%(%)%.%[%]%*%+%-%?])","%%%1"),new) end
    end
    return output
end

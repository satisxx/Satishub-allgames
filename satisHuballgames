local function safeExecutorName()
    if RunService:IsStudio() then return "Roblox Studio" end
    -- Only query public name helpers if exposed by the running environment.
    -- A missing helper does not imply that no executor is present.
    local candidates={
        function() return identifyexecutor end,
        function() return getexecutorname end,
        function() return getexecutor end,
    }
    local okEnv,env=pcall(function()return getgenv and getgenv()end)
    if okEnv and type(env)=="table" then
        for _,k in ipairs({"identifyexecutor","getexecutorname","getexecutor"}) do
            if type(env[k])=="function" then
                local ok,name=pcall(env[k])
                if ok and type(name)=="string" and #name>1 then return name end
            end
        end
    end
    for _,getFn in ipairs(candidates) do
        local ok,fn=pcall(getFn)
        if ok and type(fn)=="function" then
            local good,name=pcall(fn)
            if good and type(name)=="string" and #name>1 then return name end
        end
    end
    return "Executor não identificado"
end

-- Adaptado do teu SatisHub Murder Duels: escolhe o alvo visível mais próximo
-- do centro e solicita a deslocação para trás dele com PivotTo.
-- Esta é uma deslocação local: um servidor pode corrigi-la ou rejeitá-la.
local function tryTeleport()
    if not states.Teleport then
        UIX.status.Text=(UIX.language=="pt-PT" and "Ativa Teleport em OUTROS para usar a tecla" or "Enable Teleport in OTHERS to use the key")
        return false
    end
    if os.clock()-lastTP<.9 then return false end
    local camera=Workspace.CurrentCamera
    local c=player.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    local myRoot=c and c:FindFirstChild("HumanoidRootPart")
    if not camera or not c or not myRoot or not h or h.Health<=0 then
        UIX.status.Text="Não foi possível localizar a tua personagem"
        return false
    end
    -- Use exactly the same 400px target selector as the single on-screen hint.
    local p=getTarget(camera,400)
    local _,targetRoot=living(p)
    if not targetRoot then
        UIX.status.Text="Não há jogadores visíveis à frente da câmara"
        return false
    end
    local behind=targetRoot.CFrame*CFrame.new(0,0,4)
    local destination=CFrame.lookAt(behind.Position,targetRoot.Position)
    local ok,err=pcall(function()c:PivotTo(destination) end)
    if ok then
        lastTP=os.clock()
        UIX.status.Text="Teleporte local solicitado: "..p.DisplayName
        return true
    end
    UIX.status.Text="Falha no teleporte: "..tostring(err):sub(1,70)
    return false
end

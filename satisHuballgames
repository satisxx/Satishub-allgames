local function projectPreview(worldPosition)
    local localPoint=UIX.previewCamera.CFrame:PointToObjectSpace(worldPosition)
    local depth=-localPoint.Z
    if depth<=.01 then return nil end
    local f=276/(2*math.tan(math.rad(UIX.previewCamera.FieldOfView/2)))
    return Vector2.new(109+localPoint.X*f/depth,138-localPoint.Y*f/depth)

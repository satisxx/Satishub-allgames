local function bounds(c,cam)
    local cf,size=c:GetBoundingBox();local half=size*.5
    local a,b,cc,dd=math.huge,math.huge,-math.huge,-math.huge
    for _,x in ipairs({-1,1})do for _,y in ipairs({-1,1})do for _,z in ipairs({-1,1})do

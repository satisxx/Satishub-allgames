local function copyDiscord(value)
    local choices={}
    for _,fn in ipairs({"setclipboard","toclipboard","writeclipboard"}) do
        local f=nil
        if fn=="setclipboard" then f=setclipboard
        elseif fn=="toclipboard" then f=toclipboard
        else f=writeclipboard end
        if type(f)=="function" then table.insert(choices,f) end
    end
    local ok,env=pcall(function()return getgenv and getgenv() end)
    if ok and type(env)=="table" then
        for _,name in ipairs({"setclipboard","toclipboard","writeclipboard"}) do
            if type(env[name])=="function" then table.insert(choices,env[name]) end
        end
    end
    for _,fn in ipairs(choices) do
        local success=pcall(fn,value or "satis1x")
        if success then return true end
    end
    return false
end

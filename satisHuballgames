local function updateCameraMode()
    if not alive then return end
    minButton.Modal=states.FirstPerson and main.Visible and not minimized
    if states.FirstPerson then
        UIX.cameraLockedByScript=true
        UIX.cameraRestoreGeneration+=1
        player.CameraMinZoomDistance=.5
        player.CameraMaxZoomDistance=.5
        player.CameraMode=Enum.CameraMode.LockFirstPerson
    elseif UIX.cameraLockedByScript then
        -- Aplica a mudanca apenas na transicao ON -> OFF.
        UIX.cameraLockedByScript=false
        UIX.cameraRestoreGeneration+=1
        local generation=UIX.cameraRestoreGeneration
        UIX.restoreThirdPerson()
        -- Deixa o controlador de camera do Roblox atualizar o zoom.
        -- Uma segunda aplicacao evita ficar preso na distancia anterior.
        task.defer(function()
            RunService.RenderStepped:Wait()
            if alive and not states.FirstPerson and UIX.cameraRestoreGeneration==generation then
                UIX.restoreThirdPerson()
            end
        end)
        task.delay(.25,function()
            if alive and not states.FirstPerson and UIX.cameraRestoreGeneration==generation then
                UIX.restoreThirdPerson()
            end
        end)
    end
end
